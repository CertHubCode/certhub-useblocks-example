# CertHub API key only (secret). Tenant URLs / KT ids live in committed certhub.toml.
# Auth header used by the clients: X-API-Key
CERTHUB_API_KEY=

# Optional: set to 1 in release CI to POST evidence (push-evidence defaults to dry-run)
# CERTHUB_PUSH=1
# Optional evidence URL override when not running in GitHub Actions
# CERTHUB_EVIDENCE_URL=https://example.com/evidence
