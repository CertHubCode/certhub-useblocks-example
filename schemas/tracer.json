{
  "openapi": "3.1.0",
  "info": {
    "title": "Tracer API",
    "summary": "Service to Store and retrieve Traces between Domain Objects",
    "version": "0.1.0"
  },
  "paths": {
    "/traces": {
      "get": {
        "tags": [
          "traces"
        ],
        "summary": "Get Node Links",
        "description": "Retrieves all traces (links) associated with a node up to `n_hops` distance.\n\nArgs:\n    query_type: Determines the type of query:\n        - \"traces_list\": (default) use for traces entity display\n        - \"traces_list_with_reference_traces\": traces list plus\n          auto-reference traces (have no version)\n        - \"graph\": use for trace entity graph display",
        "operationId": "get_node_links_traces_get",
        "parameters": [
          {
            "name": "node_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Node Id"
            }
          },
          {
            "name": "node_type",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/NodeType"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Version"
            }
          },
          {
            "name": "n_hops",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "N Hops"
            }
          },
          {
            "name": "query_type",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/QueryType",
              "description": "Type of query: 'graph' for graph visualization, 'traces_list' for traces list, or 'traces_list_with_reference_traces' to include auto-reference traces",
              "default": "traces_list"
            },
            "description": "Type of query: 'graph' for graph visualization, 'traces_list' for traces list, or 'traces_list_with_reference_traces' to include auto-reference traces"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectedNodesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-public": true
      }
    },
    "/traces/batch/list": {
      "post": {
        "tags": [
          "traces"
        ],
        "summary": "Batch Retrieve Traces",
        "description": "Retrieve traces for multiple nodes in a single request.\nEach node's traces are retrieved independently and returned in a dictionary\nkeyed by the node identifier.\n\nNodes are processed concurrently. Downstream fan-out is rate-limited by\nthe module-level semaphore in NodeDataService.bulk_resolve, so parallel\nprocessing here does not multiply the upstream load on QMS / TechDoc.",
        "operationId": "batch_retrieve_traces_traces_batch_list_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRetrieveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchRetrieveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-public": true
      }
    },
    "/node/resolve": {
      "post": {
        "tags": [
          "nodes"
        ],
        "summary": "Resolve Nodes",
        "operationId": "resolve_nodes_node_resolve_post",
        "parameters": [
          {
            "name": "include_latest_approved_and_latest_available",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "When with_linked_entities is True, collapse multi-version linked targets to latest major/approved and latest fractional/available per entity.",
              "default": true,
              "title": "Include Latest Approved And Latest Available"
            },
            "description": "When with_linked_entities is True, collapse multi-version linked targets to latest major/approved and latest fractional/available per entity."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveNodesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/ResolvedNodeEntity"
                      },
                      {
                        "$ref": "#/components/schemas/ResolvedNodeEntityWithLinkedEntities"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": "Response Resolve Nodes Node Resolve Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-public": true
      }
    },
    "/nodes/version": {
      "put": {
        "tags": [
          "nodes"
        ],
        "summary": "Update Node Attributes And Associated Traces",
        "description": "Updates a node's version either in-place or by creating a new version with duplicated relationships.\n\nArgs:\n    request: FastAPI request object containing metadata\n    update: The version update parameters\n\nReturns:\n    Node: The updated/new node\n\nRaises:\n    HTTPException: If node not found or update fails",
        "operationId": "update_node_attributes_and_associated_traces_nodes_version_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeAttributesUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Node"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-public": true
      }
    }
  },
