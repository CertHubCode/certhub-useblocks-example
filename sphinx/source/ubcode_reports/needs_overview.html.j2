<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Traceability report — Sterilisator 20A</title>
  <style>
    :root {
      --report-fg: var(--vscode-foreground, #1f2328);
      --report-muted: var(--vscode-descriptionForeground, #656d76);
      --report-border: var(--vscode-panel-border, #d1d9e0);
      --report-bg: var(--vscode-editor-background, #ffffff);
      --report-link: var(--vscode-textLink-foreground, #0969da);
      --chart-bar: var(--vscode-charts-blue, #3b82f6);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --report-fg: var(--vscode-foreground, #e6edf3);
        --report-muted: var(--vscode-descriptionForeground, #8b949e);
        --report-border: var(--vscode-panel-border, #30363d);
        --report-bg: var(--vscode-editor-background, #0d1117);
        --report-link: var(--vscode-textLink-foreground, #4493f8);
      }
    }
    body {
      margin: 0;
      padding: 1.5rem 2rem 3rem;
      color: var(--report-fg);
      background: var(--report-bg);
      font-family: var(--vscode-font-family, system-ui, sans-serif);
      line-height: 1.5;
    }
    h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
    .meta { color: var(--report-muted); margin-bottom: 1.5rem; }
    h2 { font-size: 1.15rem; margin: 1.75rem 0 0.75rem; }
    p.note { color: var(--report-muted); font-size: 0.9rem; max-width: 52rem; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      margin-bottom: 0.5rem;
    }
    th, td {
      text-align: left;
      padding: 0.4rem 0.6rem;
      border-bottom: 1px solid var(--report-border);
      vertical-align: top;
    }
    th { color: var(--report-muted); font-weight: 600; }
    code { font-size: 0.85em; }
    a { color: var(--report-link); }
    .chart { max-width: 40rem; margin: 0.5rem 0 1rem; }
    .empty { color: var(--report-muted); font-style: italic; }
    ul.chain { margin: 0; padding-left: 1.1rem; }
    ul.chain li { margin: 0.15rem 0; }
  </style>
</head>
<body>
  {# Sphinx-Needs / ubCode may expose custom fields as hyphen or underscore keys. #}
  {% macro getf(n, key) -%}
    {%- set alt = key|replace('-', '_') -%}
    {%- if n[key] is defined and n[key] -%}{{ n[key] }}
    {%- elif n[alt] is defined and n[alt] -%}{{ n[alt] }}
    {%- else -%}{%- endif -%}
  {%- endmacro %}

  {% macro as_id_list(raw) -%}
    {%- if raw is none or raw == '' -%}
    {%- elif raw is string -%}
      {{- raw -}}
    {%- elif raw is mapping -%}
      {{- raw.keys()|list|join(', ') -}}
    {%- elif raw is iterable -%}
      {{- raw|join(', ') -}}
    {%- else -%}
      {{- raw -}}
    {%- endif -%}
  {%- endmacro %}

  {% macro contains_id(raw, needle) -%}
    {%- if raw is none or raw == '' -%}
    {%- elif raw is string -%}
      {%- if needle in raw.split(',')|map('trim')|list or needle in raw -%}yes{%- endif -%}
    {%- elif raw is mapping -%}
      {%- if needle in raw -%}yes{%- endif -%}
    {%- elif raw is iterable -%}
      {%- if needle in raw -%}yes{%- endif -%}
    {%- endif -%}
  {%- endmacro %}

  {% set by_id = {} %}
  {% for n in needs_list %}
    {% set _ = by_id.update({n.id: n}) %}
  {% endfor %}

  {% set sysreqs = needs_list|selectattr('type', 'equalto', 'sysreq')|list %}
  {% set douts = needs_list|selectattr('type', 'equalto', 'dout')|list %}
  {% set verifs = needs_list|selectattr('type', 'equalto', 'verif')|list %}
  {% set testcases = needs_list|selectattr('type', 'equalto', 'testcase')|list %}

  <h1>Traceability report</h1>
  <p class="meta">
    Sterilisator 20A · {{ needs_list|length }} needs indexed ·
    engineering chain SYSREQ → DOUT → code → VERIF → result
  </p>
  <p class="note">
    Full Sphinx evidence pack (graphs, JUnit, release story) lives under
    <code>sphinx/build/html/</code> / CI <code>evidence/docs/</code>.
    Risk, GSPR, CER, and PMS stay in CertHub.
  </p>

  {% set groups = needs_list|groupby('type') %}
  {% set max_count = groups|map('last')|map('length')|max %}
  <h2>1. Inventory by type</h2>
  <svg class="chart" viewBox="0 0 640 {{ groups|length * 32 + 4 }}" role="img" aria-label="Needs per type">
    {% for type, group in groups %}
    <g transform="translate(0, {{ loop.index0 * 32 }})">
      <text x="0" y="19" font-size="13" fill="currentColor">{{ type }} ({{ group|length }})</text>
      <rect x="140" y="4" height="22" rx="3"
            style="fill: var(--chart-bar)"
            width="{{ (group|length / max_count * 480)|round(1) if max_count else 0 }}"></rect>
    </g>
    {% endfor %}
  </svg>

  <h2>2. Design inputs → outputs → code → verification</h2>
  <table>
    <thead>
      <tr>
        <th>SYSREQ</th>
        <th>Status</th>
        <th>Design Output</th>
        <th>Implementation</th>
        <th>Verification</th>
        <th>Executed result</th>
      </tr>
    </thead>
    <tbody>
      {% for req in sysreqs|sort(attribute='id') %}
      {% set dout_ids = [] %}
      {% set verif_ids = [] %}
      {% for d in douts %}
        {% if contains_id(getf(d, 'links'), req.id) %}
          {% set _ = dout_ids.append(d.id) %}
        {% endif %}
      {% endfor %}
      {% for v in verifs %}
        {% if contains_id(getf(v, 'verifies'), req.id) or contains_id(getf(v, 'links'), req.id) %}
          {% set _ = verif_ids.append(v.id) %}
        {% endif %}
      {% endfor %}
      <tr>
        <td>
          <code>{{ req.id }}</code><br>
          {{ req.title }}
        </td>
        <td>{{ req.status or '—' }}</td>
        <td>
          {% if dout_ids %}
            <ul class="chain">
              {% for did in dout_ids|unique|sort %}
              <li><code>{{ did }}</code>{% if by_id.get(did) %} — {{ by_id[did].title }}{% endif %}</li>
              {% endfor %}
            </ul>
          {% else %}
            <span class="empty">none linked</span>
          {% endif %}
        </td>
        <td>
          {% set shown = [] %}
          {% for did in dout_ids|unique %}
            {% set d = by_id.get(did) %}
            {% if d %}
              {% set impl = getf(d, 'impl-file') %}
              {% set local = getf(d, 'local-url') %}
              {% set remote = getf(d, 'remote-url') %}
              {% if impl or local or remote %}
                {% set _ = shown.append(1) %}
                <ul class="chain">
                  {% if impl %}<li><code>{{ impl }}</code></li>{% endif %}
                  {% if local %}<li><a href="{{ local }}">local</a></li>{% endif %}
                  {% if remote %}<li><a href="{{ remote }}">remote</a></li>{% endif %}
                </ul>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% for vid in verif_ids|unique %}
            {% set v = by_id.get(vid) %}
            {% if v %}
              {% set impl = getf(v, 'impl-file') %}
              {% set local = getf(v, 'local-url') %}
              {% set remote = getf(v, 'remote-url') %}
              {% if impl or local or remote %}
                {% set _ = shown.append(1) %}
                <ul class="chain">
                  <li><em>test</em> <code>{{ vid }}</code></li>
                  {% if impl %}<li><code>{{ impl }}</code></li>{% endif %}
                  {% if local %}<li><a href="{{ local }}">local</a></li>{% endif %}
                  {% if remote %}<li><a href="{{ remote }}">remote</a></li>{% endif %}
                </ul>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if not shown %}
            <span class="empty">no CodeLinks yet — run <code>make show</code></span>
          {% endif %}
        </td>
        <td>
          {% if verif_ids %}
            <ul class="chain">
              {% for vid in verif_ids|unique|sort %}
              <li><code>{{ vid }}</code>{% if by_id.get(vid) %} — {{ by_id[vid].title }}{% endif %}</li>
              {% endfor %}
            </ul>
          {% else %}
            <span class="empty">none linked</span>
          {% endif %}
        </td>
        <td>
          {% set tc_hits = [] %}
          {% for tc in testcases %}
            {% set prop = getf(tc, 'certhub_test') %}
            {% set tclinks = getf(tc, 'links') %}
            {% for vid in verif_ids %}
              {% if contains_id(prop, vid) or contains_id(tclinks, vid) %}
                {% set _ = tc_hits.append(tc) %}
              {% endif %}
            {% endfor %}
          {% endfor %}
          {% for tc in tc_hits|unique %}
            <div><code>{{ tc.id }}</code> → <strong>{{ tc.result or '—' }}</strong></div>
          {% else %}
            <span class="empty">no JUnit link</span>
          {% endfor %}
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="6" class="empty">No system requirements indexed. Run <code>make sync</code>.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>3. Design Outputs with CodeLinks</h2>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Links</th>
        <th>impl-file</th>
        <th>local-url</th>
        <th>remote-url</th>
      </tr>
    </thead>
    <tbody>
      {% for d in douts|sort(attribute='id') %}
      {% set impl = getf(d, 'impl-file') %}
      {% set local = getf(d, 'local-url') %}
      {% set remote = getf(d, 'remote-url') %}
      {% set dlinks = as_id_list(getf(d, 'links')) %}
      {% if impl or local or remote or d.id == 'DOUT_018' or dlinks %}
      <tr>
        <td><code>{{ d.id }}</code></td>
        <td>{{ d.title }}</td>
        <td>{{ dlinks or '—' }}</td>
        <td>{% if impl %}<code>{{ impl }}</code>{% else %}<span class="empty">—</span>{% endif %}</td>
        <td>{% if local %}<a href="{{ local }}">open</a>{% else %}<span class="empty">—</span>{% endif %}</td>
        <td>{% if remote %}<a href="{{ remote }}">GitHub</a>{% else %}<span class="empty">—</span>{% endif %}</td>
      </tr>
      {% endif %}
      {% else %}
      <tr><td colspan="6" class="empty">No design outputs.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>4. Verifications → test code</h2>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>verifies / links</th>
        <th>impl-file</th>
        <th>URLs</th>
      </tr>
    </thead>
    <tbody>
      {% for v in verifs|sort(attribute='id') %}
      {% set impl = getf(v, 'impl-file') %}
      {% set local = getf(v, 'local-url') %}
      {% set remote = getf(v, 'remote-url') %}
      <tr>
        <td><code>{{ v.id }}</code></td>
        <td>{{ v.title }}</td>
        <td>
          {% set vv = as_id_list(getf(v, 'verifies')) %}
          {% set vl = as_id_list(getf(v, 'links')) %}
          {% if vv %}<div>verifies: <code>{{ vv }}</code></div>{% endif %}
          {% if vl %}<div>links: <code>{{ vl }}</code></div>{% endif %}
          {% if not vv and not vl %}<span class="empty">—</span>{% endif %}
        </td>
        <td>{% if impl %}<code>{{ impl }}</code>{% else %}<span class="empty">—</span>{% endif %}</td>
        <td>
          {% if local %}<a href="{{ local }}">local</a>{% endif %}
          {% if local and remote %} · {% endif %}
          {% if remote %}<a href="{{ remote }}">remote</a>{% endif %}
          {% if not local and not remote %}<span class="empty">—</span>{% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="empty">No verifications.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>5. Out of scope (CertHub)</h2>
  <p class="note">
    Risk management, GSPR, clinical evaluation, labeling, PMS/PMCF, and formal
    release approvals are controlled in CertHub — not duplicated in this report.
  </p>
</body>
</html>
